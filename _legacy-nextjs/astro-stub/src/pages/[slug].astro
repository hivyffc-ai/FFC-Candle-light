---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { siteConfig, packages, vadodaraAreas, keywordPages } from '../lib/config';

export async function getStaticPaths() {
  const paths: { params: { slug: string }; props: any }[] = [];

  // Area × service pages
  for (const area of vadodaraAreas) {
    const slug = `${area.slug}-candlelight-dinner`;
    paths.push({
      params: { slug },
      props: {
        type: 'area',
        areaName: area.name,
        slug,
        title: `Candlelight Dinner in ${area.name} Vadodara | Friends Factory Cafe`,
        description: `Book a romantic Candlelight Dinner in ${area.name}, Vadodara at Friends Factory Cafe. Packages from ₹4,700. WhatsApp booking, instant confirmation. 4.8★ rated.`,
        h1: `Candlelight Dinner in ${area.name}, Vadodara`,
        intro: `Looking for a romantic Candlelight Dinner in ${area.name}, Vadodara? Friends Factory Cafe is just a short drive away in Gotri and offers Vadodara's most-loved candlelight dining experience. Whether you're celebrating a special occasion or simply want to make your partner feel special, our team creates a magical setup tailored for you.`,
      },
    });
  }

  // Keyword pages
  for (const kw of keywordPages) {
    paths.push({
      params: { slug: kw.slug },
      props: {
        type: 'keyword',
        slug: kw.slug,
        title: kw.title + ' | Friends Factory Cafe Vadodara',
        description: kw.description || `${kw.title} at Friends Factory Cafe, Vadodara. Book romantic candlelight experiences from ₹4,700.`,
        h1: kw.h1,
        intro: kw.intro || `Discover ${kw.h1} at Friends Factory Cafe, Vadodara's most-loved romantic dining destination. Our team creates bespoke candlelight experiences starting at ₹4,700.`,
        areaName: null,
      },
    });
  }

  return paths;
}

const { type, areaName, slug, title, description, h1, intro } = Astro.props;
const waUrl = `https://wa.me/${siteConfig.whatsapp}?text=Hi Friends Factory Cafe! I'd like to book a Candlelight Dinner${areaName ? ` near ${areaName}` : ''} in Vadodara. Please share availability.`;

const breadcrumbs = [
  { name: 'Home', item: siteConfig.website },
  { name: 'Candlelight Dinner Vadodara', item: siteConfig.website + '/' },
  { name: h1, item: `${siteConfig.website}/${slug}/` },
];

const faqItems = [
  { q: `Is Friends Factory Cafe accessible from ${areaName || 'all areas of'} Vadodara?`, a: `Yes! Friends Factory Cafe is located in Gotri, Vadodara — easily reachable from ${areaName || 'all major areas'} via auto, cab, or personal vehicle. Most customers reach us within 15–25 minutes.` },
  { q: `Do I need to travel to book a Candlelight Dinner near ${areaName || 'my area'}?`, a: `Yes, our candlelight dinner setups are at our Gotri, Vadodara venue. However, we can occasionally arrange private outdoor setups in select locations — ask us on WhatsApp for details.` },
  { q: `What is the starting price for a Candlelight Dinner in Vadodara?`, a: `Our candlelight dinner packages start from ₹4,700 (Pure Love Glass House) and go up to ₹6,900 (Forever Us LoveFrame). All prices include decoration, setup, and a complete vegetarian meal.` },
  { q: `How do I book a Candlelight Dinner?`, a: `Simply message us on WhatsApp with your name, preferred date, and package choice. We'll confirm your booking within minutes and guide you through every step.` },
];
---

<Layout
  title={title}
  description={description}
  canonical={`${siteConfig.website}/${slug}/`}
  breadcrumbs={breadcrumbs}
  faqSchema={faqItems}
>
  <Header />

  <main class="pt-24 pb-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumb -->
      <nav class="text-xs text-stone-400 mb-8 flex flex-wrap gap-1.5 items-center">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span>/</span>
        <a href="/" class="hover:text-primary transition-colors">Candlelight Dinner Vadodara</a>
        <span>/</span>
        <span class="text-stone-600">{h1}</span>
      </nav>

      <!-- Hero -->
      <div class="glass rounded-2xl p-8 sm:p-12 mb-12 text-center">
        <div class="text-4xl mb-4">🕯️</div>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-stone-900 mb-4">{h1}</h1>
        <p class="text-stone-500 text-lg max-w-2xl mx-auto mb-8 leading-relaxed">{intro}</p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href={waUrl} target="_blank" rel="noopener" class="btn-primary inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Book via WhatsApp
          </a>
          <a href="/#packages" class="border border-stone-300 text-stone-700 hover:border-primary hover:text-primary px-6 py-3 rounded-xl font-medium transition-all inline-flex items-center">
            View All Packages
          </a>
        </div>
        <p class="text-stone-400 text-sm mt-4">Starting ₹4,700 · Free booking · Instant confirmation</p>
      </div>

      <!-- Packages mini-grid -->
      <section class="mb-12">
        <h2 class="font-serif text-2xl font-bold text-stone-900 mb-6 text-center">Candlelight Dinner Packages</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {packages.map((pkg) => (
            <div class="glass rounded-xl p-5 card-hover">
              <div class="text-2xl mb-2">{pkg.emoji}</div>
              <h3 class="font-serif font-bold text-stone-900 mb-1">{pkg.name}</h3>
              <div class="gradient-text font-bold text-lg mb-2">{pkg.price}</div>
              <p class="text-stone-500 text-xs leading-relaxed mb-3">{pkg.description}</p>
              <a href={`https://wa.me/${siteConfig.whatsapp}?text=Hi! I'd like the ${pkg.name} package for Candlelight Dinner near ${areaName || ''} Vadodara.`}
                target="_blank" rel="noopener" class="btn-primary text-sm py-2 block text-center">Book This</a>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ -->
      <section class="mb-12">
        <h2 class="font-serif text-2xl font-bold text-stone-900 mb-6 text-center">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {faqItems.map((item, i) => (
            <div class="glass rounded-xl overflow-hidden">
              <button class="w-full text-left flex items-center justify-between px-6 py-4 font-medium text-stone-900 hover:text-primary transition-colors faq-btn" data-index={i}>
                <span class="text-sm">{item.q}</span>
                <svg class="w-4 h-4 shrink-0 ml-3 faq-icon transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="faq-answer hidden px-6 pb-4 text-stone-500 text-sm leading-relaxed">{item.a}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- Other areas -->
      <section>
        <h2 class="font-serif text-xl font-bold text-stone-900 mb-4">Candlelight Dinner Across Vadodara</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
          {vadodaraAreas.filter(a => !areaName || a.name !== areaName).slice(0, 16).map(area => (
            <a href={`/${area.slug}-candlelight-dinner/`}
              class="text-sm py-2 px-3 rounded-lg border border-stone-100 hover:border-primary/30 hover:bg-primary/5 text-stone-500 hover:text-primary transition-all">
              {area.name}
            </a>
          ))}
        </div>
      </section>

    </div>
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>

<script>
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector('.faq-icon') as HTMLElement;
      const isOpen = !answer.classList.contains('hidden');
      document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => i.classList.remove('rotate-180'));
      if (!isOpen) { answer.classList.remove('hidden'); icon.classList.add('rotate-180'); }
    });
  });
</script>
